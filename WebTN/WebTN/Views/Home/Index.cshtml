@model IEnumerable<Code.Database.Models.SanPham>

@{
    ViewData["Title"] = "Trang Chủ - Ogani";
    Layout = "~/Views/Shared/_LayoutClient.cshtml";
}

<!-- Hero Section Begin -->
<section class="hero">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="hero__categories">
                    <div class="hero__categories__all">
                        <i class="fa fa-bars"></i>
                        <span>Danh mục món</span>
                    </div>
                    <ul>
                        <li><a href="/Product?id=1">Rau củ tươi</a></li>
                        <li><a href="/Product?id=2">Trái cây</a></li>
                        <li><a href="/Product?id=3">Hải sản tươi</a></li>
                        <li><a href="/Product?id=4">Thịt tươi</a></li>
                        <li><a href="/Product?id=5">Nước ép</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="hero__search">
                    <div class="hero__search__form">
                        <!-- ĐÃ SỬA: Đổi action sang /Product và method GET -->
                        <form action="/Product" method="get">
                            <div class="hero__search__categories">
                                Tất cả
                                <span class="arrow_carrot-down"></span>
                            </div>
                            <!-- ĐÃ SỬA: Thêm name="search" để gửi dữ liệu từ khóa -->
                            <input type="text" name="search" placeholder="Bạn muốn tìm món gì?" value="@Context.Request.Query["search"]">
                            <button type="submit" class="site-btn">TÌM KIẾM</button>
                        </form>
                    </div>
                    <div class="hero__search__phone">
                        <div class="hero__search__phone__icon">
                            <i class="fa fa-phone"></i>
                        </div>
                        <div class="hero__search__phone__text">
                            <h5>0901 234 567</h5>
                            <span>Hỗ trợ 24/7</span>
                        </div>
                    </div>
                </div>
                <div class="hero__item" style="background-image: url('https://technext.github.io/ogani/img/hero/banner.jpg'); height: 431px; background-size: cover; background-position: center;">
                    <div class="hero__text">
                        <span>THỰC PHẨM SẠCH</span>
                        <h2>Rau củ <br />100% Hữu Cơ</h2>
                        <p>Nhận và giao hàng tận nơi miễn phí</p>
                        <a href="/Product" class="primary-btn">MUA NGAY</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Hero Section End -->
<!-- Featured Section Begin (Danh sách sản phẩm từ CSDL) -->
<section class="featured spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <h2>Sản Phẩm Nổi Bật</h2>
                </div>
            </div>
        </div>

        <div class="row featured__filter">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    // Xử lý đường dẫn ảnh fallback an toàn
                    string imgPath = "https://technext.github.io/ogani/img/featured/feature-1.jpg";

                    if (!string.IsNullOrWhiteSpace(item.Anh))
                    {
                        if (item.Anh.StartsWith("http") || item.Anh.StartsWith("/"))
                        {
                            imgPath = item.Anh;
                        }
                        else
                        {
                            imgPath = "/" + item.Anh;
                        }
                    }

                    <div class="col-lg-3 col-md-4 col-sm-6 mix">
                        <div class="featured__item mb-4">
                            <!-- Khung ảnh cố định 270px và load trực tiếp từ style CSS -->
                            <div class="featured__item__pic"
                                 style="background-image: url('@imgPath'); height: 270px; background-size: cover; background-position: center; background-repeat: no-repeat; position: relative;">
                                <ul class="featured__item__pic__hover">
                                    <li><a href="javascript:void(0);"><i class="fa fa-heart"></i></a></li>
                                    <li><a href="javascript:void(0);"><i class="fa fa-retweet"></i></a></li>
                                    <li>
                                        <a href="javascript:void(0);" onclick="addToCart(@item.MaSp)">
                                            <i class="fa fa-shopping-cart"></i>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                            <div class="featured__item__text text-center pt-3">
                                <h6><a href="/Product/Details/@item.MaSp" class="text-dark font-weight-bold">@item.TenSp</a></h6>
                                <h5 class="font-weight-bold text-success mt-1">@string.Format("{0:N0} đ", item.Gia)</h5>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-4">
                    <p class="text-muted">Chưa có sản phẩm nào trong cơ sở dữ liệu.</p>
                </div>
            }
        </div>
    </div>
</section>
<!-- Featured Section End -->
@section Scripts {
    <script>
        function addToCart(productId) {
            $.ajax({
                url: '/Cart/AddToCart',
                type: 'POST',
                data: { id: productId, quantity: 1 },
                success: function (res) {
                    if (res.success) {
                        alert('Đã thêm sản phẩm vào giỏ hàng!');
                        $('#cart-count').text(res.totalQuantity);
                    }
                },
                error: function () {
                    alert('Lỗi thêm sản phẩm vào giỏ!');
                }
            });
        }
    </script>
}