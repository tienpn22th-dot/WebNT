@{
    ViewData["Title"] = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="breadcrumb-section set-bg" style="background-color: #7fad39; padding: 30px 0;">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    <h2 style="color: white; font-weight: 700;">Đăng ký</h2>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="checkout spad">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="checkout__form" style="background: #f5f5f5; padding: 40px; border-radius: 10px;">
                    <h4 class="text-center mb-4" style="color: #1c1c1c; font-weight: 700; border-bottom: 2px solid #7fad39; padding-bottom: 10px;">TẠO TÀI KHOẢN MỚI</h4>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger text-center">@ViewBag.Error</div>
                    }

                    <form action="/Account/Register" method="post">
                        <div class="checkout__input">
                            <p>Họ và Tên <span>*</span></p>
                            <input type="text" name="name" required placeholder="Nguyễn Văn A">
                        </div>
                        <div class="checkout__input">
                            <p>Tên đăng nhập <span>*</span></p>
                            <input type="text" name="loginName" required placeholder="username">
                        </div>
                        <div class="checkout__input">
                            <p>Email <span>*</span></p>
                            <input type="email" name="email" required placeholder="example@gmail.com">
                        </div>
                        <div class="checkout__input">
                            <p>Mật khẩu <span>*</span></p>
                            <input type="password" name="password" required placeholder="******">
                        </div>
                        <div class="checkout__input">
                            <p>Xác nhận mật khẩu <span>*</span></p>
                            <input type="password" name="confirmPassword" required placeholder="******">
                        </div>

                        <button type="submit" class="site-btn w-100 mt-3" style="background: #7fad39; border-radius: 5px;">ĐĂNG KÝ</button>

                        <div class="text-center mt-4">
                            <p>Đã có tài khoản? <a href="/Account/Login" style="color: #7fad39; font-weight: 600;">Đăng nhập</a></p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>