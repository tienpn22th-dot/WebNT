@{
    ViewData["Title"] = "Nhóm quyền";
    Layout = "~/Areas/Admin/Views/Shared/_Admin.cshtml"; // Chỉnh lại đường dẫn Layout nếu cần
}

<!-- Content Header -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Nhóm quyền</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Trang chủ</a></li>
                    <li class="breadcrumb-item active">Nhóm quyền</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-primary">
            <div class="card-header">
                <h3 class="card-title">Danh sách nhóm quyền</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-primary btn-sm" onclick="openModal()">
                        <i class="fas fa-plus"></i> Thêm mới
                    </button>
                </div>
            </div>
            <div class="card-body">
                <table id="tblGroup" class="table table-bordered table-striped w-100">
                    <thead>
                        <tr>
                            <th style="width: 50px">#</th>
                            <th>Tên nhóm</th>
                            <th style="width: 150px" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- Modal Thêm/Sửa -->
<div class="modal fade" id="groupModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm nhóm quyền</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="formGroup">
                    <input type="hidden" id="groupId" name="id" />
                    <div class="form-group">
                        <label for="groupName">Tên nhóm quyền <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="groupName" name="name" placeholder="Nhập tên nhóm quyền">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="saveGroup()">Lưu dữ liệu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var dataTable;

        $(document).ready(function () {
            // Khởi tạo DataTables gọi API getList
            dataTable = $('#tblGroup').DataTable({
                "processing": true,
                "serverSide": true,
                "ajax": {
                    "url": "/Admin/Group/getList",
                    "type": "POST",
                    "dataType": "json"
                },
                "columns": [
                    {
                        "data": null,
                        "render": function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        },
                        "orderable": false
                    },
                    {
                        "data": "name",
                        "name": "Name"
                    },
                    {
                        "data": "id",
                        "render": function (data, type, row) {
                            return `
                                <div class="text-center">
                                    <button class="btn btn-warning btn-xs" onclick="editGroup('${row.id}', '${row.name}')">
                                        <i class="fas fa-edit"></i> Sửa
                                    </button>
                                    <button class="btn btn-danger btn-xs" onclick="deleteGroup('${row.id}')">
                                        <i class="fas fa-trash"></i> Xóa
                                    </button>
                                </div>
                            `;
                        },
                        "orderable": false,
                        "className": "text-center"
                    }
                ],
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Vietnamese.json"
                }
            });
        });

        // Mở modal Thêm mới
        function openModal() {
            $('#groupId').val('');
            $('#groupName').val('');
            $('#modalTitle').text('Thêm nhóm quyền');
            $('#groupModal').modal('show');
        }

        // Mở modal Sửa
        function editGroup(id, name) {
            $('#groupId').val(id);
            $('#groupName').val(name);
            $('#modalTitle').text('Cập nhật nhóm quyền');
            $('#groupModal').modal('show');
        }

        // Gọi Ajax Lưu (Thêm/Sửa)
        function saveGroup() {
            var id = $('#groupId').val();
            var name = $('#groupName').val();

            if (!name.trim()) {
                alert('Vui lòng nhập tên nhóm quyền!');
                return;
            }

            $.ajax({
                url: '/Admin/Group/Save',
                type: 'POST',
                data: { id: id, name: name },
                success: function (res) {
                    if (res.success) {
                        $('#groupModal').modal('hide');
                        dataTable.ajax.reload(); // Reload lại bảng
                        alert(res.message);
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert('Đã có lỗi xảy ra!');
                }
            });
        }

        // Gọi Ajax Xóa
        function deleteGroup(id) {
            if (confirm('Bạn có chắc chắn muốn xóa nhóm quyền này?')) {
                $.ajax({
                    url: '/Admin/Group/Delete',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        if (res.success) {
                            dataTable.ajax.reload();
                            alert(res.message);
                        } else {
                            alert(res.message);
                        }
                    },
                    error: function () {
                        alert('Đã có lỗi xảy ra!');
                    }
                });
            }
        }
    </script>
}